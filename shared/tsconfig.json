{
  // Code shared by web, poi-plugin-sim and server. Must pass the strictest flags of all of them.
  // Check: server/node_modules/.bin/tsc -p shared
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "typeRoots": ["../server/node_modules/@types"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": ["."]
}
